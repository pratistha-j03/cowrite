{
  "name": "cowrite",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "realtime",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:realtime": "npm run dev -w realtime",
    "dev:client": "npm run dev -w client",
    "db:migrate": "dotenv -e .env -- npm run migrate -w @cowrite/shared",
    "db:generate": "dotenv -e .env -- npm run generate -w @cowrite/shared"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
